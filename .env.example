# ---------------------------------------------------------------------------
# Rental Property Operations Tracker - environment contract
# Copy to .env.local (never commit the copy) and fill in real values.
# Setup instructions for each block are in README.md.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled connection string, used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/rental?sslmode=require"
# Direct (unpooled) connection string, used only by migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/rental?sslmode=require"

# --- Auth.js (Google SSO) ---------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Local dev: http://localhost:4000 - production: https://your-app.vercel.app
AUTH_URL="http://localhost:4000"
AUTH_GOOGLE_ID="xxxxxxxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# Only these Google accounts may sign in. Comma separated, case insensitive.
# Two users, one household - keep this list short.
ALLOWED_EMAILS="you@gmail.com,spouse@gmail.com"

# --- Receipt storage (AWS S3) ----------------------------------------------
AWS_REGION="us-east-2"
AWS_S3_BUCKET="rental-property-receipts"
AWS_ACCESS_KEY_ID="replace-me"
AWS_SECRET_ACCESS_KEY="replace-me"

# --- Receipt reading (Anthropic) --------------------------------------------
# Reads an uploaded receipt and pre-fills the expense form. Optional: without
# it uploads still work, they just arrive as an attachment with no figures.
ANTHROPIC_API_KEY="replace-me"

# --- Application ------------------------------------------------------------
# IANA timezone used to decide what "today" and "this tax year" mean.
# Every date in the app is anchored to this zone, not to UTC or the browser.
APP_TIMEZONE="America/New_York"
